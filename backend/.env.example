# --- Database ---
# Production target is Postgres. For local dev without a Postgres instance,
# you can point this at a sqlite file instead and switch the `provider` in
# prisma/schema.prisma to "sqlite" (do NOT ship that switch to production).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hearing_manager"

# --- Server ---
PORT=3978
TAB_ORIGIN="https://localhost:53000"

# --- Microsoft Graph / Bot Framework ---
# These come from the Entra ID app registration described in
# docs/README.md section "Azure / Entra ID prerequisites". Until that
# registration exists, leave GRAPH_MODE=mock so the backend simulates
# Graph responses instead of calling out.
GRAPH_MODE=mock
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# The judge/organizer whose OnlineMeeting this deployment manages, and the
# meeting id — one deployment manages one meeting (see docs/README.md §1).
ORGANIZER_USER_ID=
ONLINE_MEETING_ID=
