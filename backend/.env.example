# --- Database ---
# Production target is Postgres. For local dev without a Postgres instance,
# you can point this at a sqlite file instead and switch the `provider` in
# prisma/schema.prisma to "sqlite" (do NOT ship that switch to production).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hearing_manager"

# --- Server ---
PORT=3978
TAB_ORIGIN="https://localhost:53000"

# --- Microsoft Graph / Bot Framework ---
# These come from the Entra ID app registration described in
# docs/README.md section "Azure / Entra ID prerequisites". Until that
# registration exists, leave GRAPH_MODE=mock so the backend simulates
# Graph responses instead of calling out.
GRAPH_MODE=mock
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=

# The judge/organizer whose OnlineMeeting this deployment manages, and the
# meeting id — one deployment manages one meeting (see docs/README.md §1).
ORGANIZER_USER_ID=
ONLINE_MEETING_ID=

# --- Auth (Teams SSO) ---
# AUTH_MODE=teams-sso (default) validates every /api/* request's
# Authorization: Bearer <token> header as a real Azure AD token minted for
# this app via Teams SSO — see backend/src/auth/verifyTeamsToken.ts and
# tab/src/teamsContext.ts. Requires MICROSOFT_APP_ID and
# MICROSOFT_APP_TENANT_ID above, plus TAB_HOSTNAME below (used to check the
# token's audience against api://<TAB_HOSTNAME>/<MICROSOFT_APP_ID>, matching
# manifest.json's webApplicationInfo.resource).
#
# AUTH_MODE=dev-bypass skips real token validation and trusts an
# x-actor-email header instead (or ?actorEmail= in the tab, see
# tab/src/teamsContext.ts dev fallback) — only for local dev without a real
# Entra app registration. NEVER set this in production: it lets any caller
# attribute audit-log entries to any judge they like.
AUTH_MODE=dev-bypass
TAB_HOSTNAME=

# Roster join/leave simulation (POST /api/roster/event) and the
# connection-health toggle are for local dev/testing only — the real bot
# never calls them over HTTP (see backend/src/bot/index.ts). Leave unset
# (disabled) outside of local dev.
ALLOW_ROSTER_SIMULATION=true
