// Judiciary Hearing Administrator — data model
// See docs/README.md section 4 for rationale.

datasource db {
  // SQL Server — the organization's own instance, no external/paid database
  // service required (docs/README.md "Database"). Three things Postgres
  // gave us for free that SQL Server's Prisma connector doesn't support at
  // all, each worked around below:
  //   - No scalar-list/array type → the *Email child-table models
  //     (JudgeEmail/PartyEmail) stand in for `emails String[]` — see the
  //     comments on JudgeOrAuxiliary/ExpectedParty.
  //   - No `Json` column type → AuditLogEntry.before/after are plain
  //     `String? @db.NVarChar(Max)` holding JSON.stringify'd text;
  //     services/auditLog.ts does the stringify/parse at the boundary.
  //   - No native enum type → every enum below became a plain `String`
  //     field holding the same literal values (e.g. "ACTIVE", "PARTY");
  //     nothing in the TS code imported Prisma's enum types directly (it
  //     already used string-literal unions everywhere), so this is a
  //     schema-only change.
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// The tenant boundary: one Meeting per live Teams meeting (docs §1 — "one
// meeting per hearing day/session"). id is the Teams conversation/meeting
// ID (activity.conversation.id on the bot side, context.meeting.id from
// the tab's Teams JS SDK context) — that ID is handed to us by Teams for
// free on both the bot and the tab, unlike Graph's onlineMeetingId, so it's
// what every other table is scoped by. organizerUserId/onlineMeetingId are
// filled in separately (see routes/meetings.ts) once/if needed for the
// Graph role-PATCH (graph/roleManager.ts) — nullable because a meeting can
// exist here (roster events flowing, hearings being tracked) before that
// resolution has happened, and GRAPH_MODE=mock never needs it at all.
model Meeting {
  id              String    @id
  organizerUserId String?
  onlineMeetingId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Set once by the "End session" action (routes/session.ts) — sends every
  // judge/auxiliary a personalized closure summary, see services/
  // sessionSummary.ts. Re-ending an already-ended session is rejected.
  endedAt         DateTime?
  endedBy         String?

  hearings        Hearing[]
  rosterEntries   RosterEntry[]
  rosterEvents    RosterConnectionEvent[]
  judges          JudgeOrAuxiliary[]
  auditEntries    AuditLogEntry[]
  presenterGrants PresenterGrant[]
}

model Hearing {
  id            String    @id @default(cuid())
  meetingId     String
  meeting       Meeting   @relation(fields: [meetingId], references: [id])
  hearingNumber Int
  // "PENDING" | "ACTIVE" | "COMPLETED" — explicit lifecycle states
  // (distinct from the *derived* ready/incomplete/no_show attendance
  // status — see services/statusDerivation.ts). Was a Prisma enum before
  // the SQL Server switch (datasource db's comment above); every call site
  // already compared against these same string literals, so this is a
  // schema-only change.
  state         String    @default("PENDING")
  // From the case-management system's daily feed (services/cmsImport.ts) —
  // when this hearing was scheduled for, not when it actually ran (that's
  // HearingPeriod). Null for hearings created by other means (routes/
  // hearings.ts, routes/provision.ts without a date).
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  expectedParties ExpectedParty[]
  periods         HearingPeriod[]
  remaps          RemapMapping[]
  auditEntries    AuditLogEntry[]
  notes           HearingNote[]

  @@unique([meetingId, hearingNumber])
  @@index([meetingId])
}

// Personal, per-author notes (docs/README.md — never shared/crossed between
// staff). Replaces the old single Hearing.notes field. The live UI/socket
// snapshot never includes these; only GET /notes (scoped to the calling
// user's own authorEmail) exposes them — see routes/notes.ts.
model HearingNote {
  id          String   @id @default(cuid())
  hearingId   String
  hearing     Hearing  @relation(fields: [hearingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  authorEmail String
  text        String   @default("")
  updatedAt   DateTime @updatedAt

  @@unique([hearingId, authorEmail])
  @@index([hearingId])
}

// An explicit, ad-hoc override giving someone presenter (mic/camera) rights
// they wouldn't otherwise have — e.g. a general-public observer staff wants
// to let speak. Independent of hearing membership; combined with judges/
// auxiliaries and the active hearing's parties in services/presenterRules.ts
// to compute the full attendee-role map. Unlike mute/camera-off (one-shot,
// unpersisted — see graph/client.ts), this is real, persisted state that
// actually changes what gets PATCHed to Graph.
model PresenterGrant {
  id        String    @id @default(cuid())
  meetingId String
  meeting   Meeting   @relation(fields: [meetingId], references: [id])
  email     String
  grantedBy String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  revokedBy String?

  @@index([meetingId])
}

model HearingPeriod {
  id        String    @id @default(cuid())
  hearingId String
  hearing   Hearing   @relation(fields: [hearingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([hearingId])
}

// A person can have more than one known email (a work alias, a personal
// M365 account) — every one of them counts for roster/attendance matching
// (statusDerivation.ts checks membership across the whole array, not just
// one field), so joining Teams with any of them counts as present.
// externalUid is the case-management system's PersonUID (services/
// cmsImport.ts) — nullable because a party added by hand (routes/
// parties.ts) or by routes/provision.ts without one has no such identity;
// when present, it's what re-imports match against (see @@unique below)
// rather than name/email, which can legitimately change between imports.
model ExpectedParty {
  id          String       @id @default(cuid())
  hearingId   String
  hearing     Hearing      @relation(fields: [hearingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  name        String
  emails      PartyEmail[]
  // "PARTY" | "COUNSEL" | "WITNESS" | "OTHER" — was a Prisma enum, see
  // datasource db's comment above.
  role        String       @default("PARTY")
  externalUid String?

  remapsTargeting RemapMapping[]

  @@unique([hearingId, externalUid])
  @@index([hearingId])
}

// Child table standing in for what would be `emails String[]` on Postgres —
// SQL Server has no scalar-list type. Every Prisma call site that reads or
// writes ExpectedParty.emails maps to/from a plain `string[]` immediately
// at the query boundary (see services/statusDerivation.ts's ExpectedPartyLike
// for the shape everything else in the app still operates on).
model PartyEmail {
  id              String        @id @default(cuid())
  expectedPartyId String
  expectedParty   ExpectedParty @relation(fields: [expectedPartyId], references: [id], onDelete: Cascade)
  email           String

  @@index([expectedPartyId])
  @@index([email])
}

// Live roster, fed exclusively by bot roster events (join/leave). Source of
// truth for "who is currently connected" — never polled, never derived.
// Scoped per meeting: the same person's email can legitimately show up
// connected in two different concurrent meetings.
model RosterEntry {
  id          String    @id @default(cuid())
  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id])
  email       String
  displayName String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?
  isConnected Boolean   @default(true)
  updatedAt   DateTime  @updatedAt

  @@unique([meetingId, email])
  @@index([meetingId])
}

// Append-only join/leave log — RosterEntry above is a single overwritten
// row per (meetingId, email), so it can only ever answer "is this person
// connected right now" and "when did they last join/leave," never "list
// every time this person joined/left" (someone can drop and rejoin more
// than once in a session). Fed from the exact same roster events as
// RosterEntry (routes/roster.ts's applyRosterEvent, called for judges,
// parties, and general public alike) — this is what lets the session-end
// summary (services/sessionSummary.ts) print a full connection log per
// person, including general public.
model RosterConnectionEvent {
  id          String   @id @default(cuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id])
  email       String
  displayName String
  // "JOINED" | "LEFT" — was a Prisma enum, see datasource db's comment
  // above.
  type        String
  occurredAt  DateTime @default(now())

  @@index([meetingId])
  @@index([meetingId, email])
}

model RemapMapping {
  id                      String         @id @default(cuid())
  rosterEmail             String
  // "EXISTING_PARTY" | "NEW_PARTY" — was a Prisma enum, see datasource db's
  // comment above.
  mappedToType            String
  mappedToExpectedPartyId String?
  mappedToExpectedParty   ExpectedParty? @relation(fields: [mappedToExpectedPartyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  newPartyName            String?
  hearingId               String
  hearing                 Hearing        @relation(fields: [hearingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt               DateTime       @default(now())
  undoneAt                DateTime?

  @@index([hearingId])
  @@index([rosterEmail])
}

// Scoped per meeting: a judge presides over one meeting at a time, and the
// same person may be a JUDGE in one meeting and, say, SECRETARY in another
// on a different day. emails/externalUid follow the same reasoning as
// ExpectedParty above — every known email counts for presence matching,
// and externalUid (the CMS's PersonUID, when known) is what re-imports
// match against.
model JudgeOrAuxiliary {
  id          String       @id @default(cuid())
  meetingId   String
  meeting     Meeting      @relation(fields: [meetingId], references: [id])
  emails      JudgeEmail[]
  name        String
  // "JUDGE" | "PRESIDING_JUDGE" | "SECRETARY" | "OTHER_OFFICER" — was a
  // Prisma enum, see datasource db's comment above.
  role        String
  externalUid String?

  @@unique([meetingId, externalUid])
  @@index([meetingId])
}

// Child table standing in for what would be `emails String[]` on Postgres —
// see the identical comment on PartyEmail above; same boundary-mapping
// strategy applies to every JudgeOrAuxiliary.emails call site.
model JudgeEmail {
  id                 String           @id @default(cuid())
  judgeOrAuxiliaryId String
  judgeOrAuxiliary   JudgeOrAuxiliary @relation(fields: [judgeOrAuxiliaryId], references: [id], onDelete: Cascade)
  email              String

  @@index([judgeOrAuxiliaryId])
  @@index([email])
}

// Every role change, remap, undo, and status transition — actor, timestamp,
// before/after state. This is a record of how a hearing was actually
// conducted; never delete rows from this table. meetingId is set even for
// entries without a hearingId (e.g. a message send not tied to one hearing)
// so the audit trail stays scoped and queryable per meeting too.
//
// before/after hold JSON.stringify'd text (SQL Server's Prisma connector has
// no `Json` column type — see datasource db's comment above), stringified/
// parsed exclusively by services/auditLog.ts so nothing else in the app
// needs to know the column is a string underneath. @db.NVarChar(Max)
// because plain NVarChar on SQL Server defaults to a 1000-char cap, which
// would silently truncate a larger before/after snapshot (e.g. a hearing's
// full attendanceAtClose).
model AuditLogEntry {
  id         String   @id @default(cuid())
  meetingId  String?
  meeting    Meeting? @relation(fields: [meetingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hearingId  String?
  hearing    Hearing? @relation(fields: [hearingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actorEmail String
  action     String
  before     String?  @db.NVarChar(Max)
  after      String?  @db.NVarChar(Max)
  createdAt  DateTime @default(now())

  @@index([meetingId])
  @@index([hearingId])
  @@index([createdAt])
}
