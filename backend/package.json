{
  "name": "hearing-manager-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for the Judiciary Hearing Administrator Teams app — holds application state, derives hearing status, performs Microsoft Graph calls, and pushes live updates to the tab.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:tab": "npm --prefix ../tab install && npm --prefix ../tab run build",
    "copy:tab": "node scripts/copy-tab-dist.js",
    "build": "npm run build:tab && npm run copy:tab && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^5.19.1",
    "botbuilder": "^4.23.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.10",
    "prisma": "^5.19.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
