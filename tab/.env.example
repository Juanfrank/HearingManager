# Vite only exposes vars prefixed VITE_ to client code — these get baked
# into the build at compile time (`npm run build`), not read at runtime.

# --- Interactive Teams SSO consent fallback (auth-start.ts) ---
# Same App ID / tenant as backend/.env's MICROSOFT_APP_ID /
# MICROSOFT_APP_TENANT_ID — duplicated here because the tab is a static
# build with no access to the backend's environment. Required for the
# interactive-consent popup (teamsContext.ts's getAuthToken() fallback,
# see docs/README.md "Auth: Teams SSO") to work; without it, that fallback
# shows an inline error instead of redirecting to Microsoft's consent
# prompt — silent SSO (the normal path, once consent exists) is
# unaffected either way.
VITE_MICROSOFT_APP_ID=
VITE_MICROSOFT_APP_TENANT_ID=
# Only set this if the App ID URI genuinely isn't api://<this host>/<App
# ID> (manifest.json's webApplicationInfo.resource) — the default covers
# every normal deployment.
VITE_APP_ID_URI=

# --- Only needed if the tab is ever deployed pointing at a backend on a
# genuinely different origin than itself — see api.ts/socket.ts's
# comments on why these default to relative/same-origin otherwise. ---
VITE_API_BASE=
VITE_SOCKET_BASE=
